# Arquivos de distribuicao e temporarios
# ---------------------------------------------------------------------------
*.zip
*.7z
*.rar
/temp_cores_dl/
# Saida de build. Uma excecao: o dist/version.json e o manifesto do
# auto-update, e o updater usa a copia dele no GitHub como fallback quando
# karamelo-emu.com nao responde - por isso ele precisa estar versionado.
# Git nao consegue reincluir um arquivo dentro de um diretorio excluido,
# entao a regra ignora o conteudo (/dist/*) em vez do diretorio (/dist).
/dist/*
!/dist/version.json

# ---------------------------------------------------------------------------
# Rust / Cargo build artifacts (evita inflar o repo com gigabytes de binários)
# ---------------------------------------------------------------------------
**/target/
/third_party/gopher64/target/
*.rlib
*.rmeta
*.d

# ---------------------------------------------------------------------------
# Lock files e temporários de build / ferramentas
# ---------------------------------------------------------------------------
*.lock
*.lock*
.gradle/
**/.gradle/
# Credenciais de deploy (o .example.bat vai para o repositorio, estes nao)
/deploy_env.bat
/deploy_env.sh
/tools/download_bios.ps1
/tools/download_bios.ps1

# Script local de download de BIOS - fica fora do repositorio
/tools/download_bios.ps1

