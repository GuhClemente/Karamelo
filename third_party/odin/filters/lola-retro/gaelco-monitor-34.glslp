# Odin - the 34-inch monitor of Gaelco's ATV Track MOTION cabinet: "34" Hantarex Polo/2 STAR PH" (manual), the same
# auto-sync chassis as the 28-inch, driven at 31 kHz by the board, on the shaders of Lola Retro for 86Box (MIT, by
# Zoki). No tube found: its face (2 inches under the nominal size, as on the 28 and 29-inch tubes), the slot mask and
# EBU phosphors (as on the 28-inch), the pitch and white of Wells-Gardner's 33-inch D9200 (data sheet), the spots
# (Lola's average 15-inch scaled to 480 lines on it), convergence, corners and curvature are HEURISTIC.

shaders = 7

shader0 = shaders/encode.glsl
alias0 = LR_Signal
filter_linear0 = false
wrap_mode0 = clamp_to_border
scale_type_x0 = source
scale_x0 = 4.0
scale_type_y0 = source
scale_y0 = 1.0
float_framebuffer0 = true

shader1 = shaders/decode.glsl
alias1 = LR_Decoded
filter_linear1 = true
wrap_mode1 = clamp_to_edge
scale_type_x1 = source
scale_x1 = 1.0
scale_type_y1 = source
scale_y1 = 1.0
float_framebuffer1 = true

shader2 = shaders/glow-h.glsl
filter_linear2 = true
wrap_mode2 = clamp_to_edge
scale_type_x2 = source
scale_x2 = 0.125
scale_type_y2 = source
scale_y2 = 0.5
float_framebuffer2 = true

shader3 = shaders/glow-v.glsl
alias3 = LR_Glow
filter_linear3 = true
wrap_mode3 = clamp_to_edge
scale_type_x3 = source
scale_x3 = 1.0
scale_type_y3 = source
scale_y3 = 1.0
float_framebuffer3 = true

shader4 = shaders/beam.glsl
alias4 = LR_Beam
filter_linear4 = true
wrap_mode4 = clamp_to_edge
scale_type_x4 = absolute
scale_x4 = 8192
scale_type_y4 = source
scale_y4 = 2.05
float_framebuffer4 = true

shader5 = shaders/crt.glsl
filter_linear5 = true
wrap_mode5 = clamp_to_edge
scale_type_x5 = viewport
scale_x5 = 1.0
scale_type_y5 = viewport
scale_y5 = 1.0
float_framebuffer5 = true

shader6 = shaders/present.glsl
filter_linear6 = false
wrap_mode6 = clamp_to_edge

parameters = "LR_MON_SIZE;LR_MON_PITCH;LR_MASK_TYPE;LR_MON_SPOT_LO;LR_MON_SPOT_HI;LR_MON_CORNER;LR_CONV;LR_PHOS;LR_WHITE;LR_CURV_X;LR_CURV_Y;LR_OVERSCAN"
LR_MON_SIZE = 33
LR_MON_PITCH = 0.92
LR_MASK_TYPE = 2
LR_MON_SPOT_LO = 0.69
LR_MON_SPOT_HI = 1.03
LR_MON_CORNER = 1.7
LR_CONV = 0.35
LR_PHOS = 3
LR_WHITE = 8500
LR_CURV_X = 0.035
LR_CURV_Y = 0.045
LR_OVERSCAN = 0
