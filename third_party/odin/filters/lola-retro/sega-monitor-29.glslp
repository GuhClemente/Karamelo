# Odin - the 29-inch 31 kHz monitor of Sega's Hikaru cabinets (Planet Harriers, NASCAR Arcade standard:
# "ASSY CLR DSPL 29TYPE 31K 2934", a Nanao), on the shaders of Lola Retro for 86Box (MIT, by Zoki).
# Its size is in the manuals; its dot pitch, mask, beam spots, convergence and curvature are HEURISTIC (no data
# sheet found): a 68 cm Toshiba tube with a slot mask, the spots of Lola's average 15-inch scaled to 480 lines on it.

shaders = 7

shader0 = shaders/encode.glsl
alias0 = LR_Signal
filter_linear0 = false
wrap_mode0 = clamp_to_border
scale_type_x0 = source
scale_x0 = 4.0
scale_type_y0 = source
scale_y0 = 1.0
float_framebuffer0 = true

shader1 = shaders/decode.glsl
alias1 = LR_Decoded
filter_linear1 = true
wrap_mode1 = clamp_to_edge
scale_type_x1 = source
scale_x1 = 1.0
scale_type_y1 = source
scale_y1 = 1.0
float_framebuffer1 = true

shader2 = shaders/glow-h.glsl
filter_linear2 = true
wrap_mode2 = clamp_to_edge
scale_type_x2 = source
scale_x2 = 0.125
scale_type_y2 = source
scale_y2 = 0.5
float_framebuffer2 = true

shader3 = shaders/glow-v.glsl
alias3 = LR_Glow
filter_linear3 = true
wrap_mode3 = clamp_to_edge
scale_type_x3 = source
scale_x3 = 1.0
scale_type_y3 = source
scale_y3 = 1.0
float_framebuffer3 = true

shader4 = shaders/beam.glsl
alias4 = LR_Beam
filter_linear4 = true
wrap_mode4 = clamp_to_edge
scale_type_x4 = absolute
scale_x4 = 8192
scale_type_y4 = source
scale_y4 = 2.05
float_framebuffer4 = true

shader5 = shaders/crt.glsl
filter_linear5 = true
wrap_mode5 = clamp_to_edge
scale_type_x5 = viewport
scale_x5 = 1.0
scale_type_y5 = viewport
scale_y5 = 1.0
float_framebuffer5 = true

shader6 = shaders/present.glsl
filter_linear6 = false
wrap_mode6 = clamp_to_edge

parameters = "LR_MON_SIZE;LR_MON_PITCH;LR_MASK_TYPE;LR_MON_SPOT_LO;LR_MON_SPOT_HI;LR_MON_CORNER;LR_CONV;LR_PHOS;LR_WHITE;LR_CURV_X;LR_CURV_Y;LR_OVERSCAN"
LR_MON_SIZE = 28
LR_MON_PITCH = 0.75
LR_MASK_TYPE = 2
LR_MON_SPOT_LO = 0.58
LR_MON_SPOT_HI = 0.87
LR_MON_CORNER = 1.5
LR_CONV = 0.2
LR_PHOS = 4
LR_WHITE = 9300
LR_CURV_X = 0.035
LR_CURV_Y = 0.045
LR_OVERSCAN = 0
