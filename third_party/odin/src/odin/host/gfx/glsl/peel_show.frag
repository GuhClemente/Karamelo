/* The peeled layers shown where a fragment was blended */

uniform sampler2D u_color;
uniform sampler2D u_last;

out vec4 fragColor;

void
main (void)
{
	ivec2 pixel = ivec2 (gl_FragCoord.xy);

	if (texelFetch (u_last, pixel, 0).x == 2.0)
		discard;
	fragColor = texelFetch (u_color, pixel, 0) / 255.0;
}
