<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded by compile.bat (/MANIFEST:EMBED /MANIFESTINPUT).

  activeCodePage UTF-8 (Windows 10 1903+): every narrow string in this process -
  file names from the ROM browser, fopen, std::filesystem, and the paths cores
  receive in retro_game_info - is UTF-8. Before this, a file name with
  characters outside the legacy ANSI code page (a Japanese title) could not be
  represented at all: it threw inside std::filesystem and the file was left out
  of the list. Older Windows ignores the setting and behaves as before.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
